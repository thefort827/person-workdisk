# ============ Supabase（后端数据库）============
# 复制本文件为 .env 并填入真实值（本地开发用）；Vercel 上在项目 Settings -> Environment Variables 配置同名变量
SUPABASE_URL=https://cnurfjamlzxbnctkfezv.supabase.co
# 服务端密钥：仅用于 Vercel Serverless 函数，绝不暴露给浏览器（真实值见基础资源.txt / 你本地 .env）
SUPABASE_SECRET_KEY=sb_secret_请替换为你的真实密钥

# ============ 访问口令（可选）============
# 设置后，前端需要输入口令才能读写数据；不设置则开放访问（个人使用推荐设置）
APP_TOKEN=

# ============ AI 财务助手（小米 MiMo）============
# 在 https://platform.xiaomimimo.com 控制台创建 API Key（sk- 开头，按量付费）
# 密钥只存在后端环境变量，绝不写进前端代码或仓库
MIMO_API_KEY=sk-请替换为你的MiMo密钥
# MiMo 按量付费接口地址（sk- 密钥对应此地址；Token Plan 的 tp- 密钥对应 token-plan-cn.xiaomimimo.com）
MIMO_API_BASE=https://api.xiaomimimo.com/v1
# 模型：mimo-v2.5 / mimo-v2.5-pro 等
MIMO_MODEL=mimo-v2.5
# 单次回答最大 token 数（可选）
MIMO_MAX_TOKENS=1600
